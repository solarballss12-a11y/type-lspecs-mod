      "com.example.lspecs.LSpecsClient"
    ]
  },
  "mixins": [
    "lspecs.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
